{$PUBLIC_HOST:localhost} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss: ws: https: http:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
  }

  handle /ws {
    reverse_proxy signal:8080
  }

  handle /api/* {
    reverse_proxy signal:8080
  }

  handle /healthz {
    reverse_proxy signal:8080
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
